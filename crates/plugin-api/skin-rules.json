{
  "$comment": "The App skins contract (skinApi 1). One source for the Rust validator, the web engine and the docs. Additive changes only within a major version; see docs/app-skins.md.",
  "skinApi": 1,
  "supported": [1],
  "limits": {
    "textBytes": 524288,
    "assetBytes": 5242880,
    "files": 64,
    "partialDepth": 8,
    "cardElements": 60
  },
  "devices": ["phone", "tablet", "desktop", "tv"],
  "pages": {
    "shell": { "scope": "App", "variants": [] },
    "home": { "scope": "Home", "variants": [] },
    "library": { "scope": "Library", "variants": [] },
    "item": { "scope": "Item", "variants": ["movie", "series", "season", "episode"] },
    "search": { "scope": "Search", "variants": [] }
  },
  "assetTypes": {
    "woff2": "font/woff2",
    "woff": "font/woff",
    "webp": "image/webp",
    "avif": "image/avif",
    "png": "image/png",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "svg": "image/svg+xml",
    "gif": "image/gif"
  },
  "tags": [
    "div", "span", "section", "header", "footer", "nav", "main", "aside", "article",
    "h1", "h2", "h3", "h4", "h5", "h6", "p", "ul", "ol", "li", "dl", "dt", "dd",
    "figure", "figcaption", "strong", "em", "b", "i", "u", "s", "small", "mark", "abbr",
    "br", "hr", "time", "blockquote", "a", "button", "img", "picture", "details", "summary",
    "select", "option", "input", "label",
    "svg", "g", "path", "circle", "rect", "line", "polyline", "polygon", "ellipse", "defs",
    "lineargradient", "radialgradient", "stop", "title", "desc", "clippath", "mask", "text", "tspan", "symbol", "use"
  ],
  "tagsNeedBinding": { "select": "data-kn-select", "input": "data-kn-search" },
  "voidTags": ["br", "hr", "img", "input", "source", "wbr", "area", "col", "embed", "meta", "link", "base", "param", "track"],
  "attributes": {
    "global": ["class", "id", "role", "title", "hidden", "popover", "popovertarget", "popovertargetaction", "tabindex", "style", "lang", "dir", "open", "slot", "translate"],
    "prefixes": ["aria-", "data-"],
    "perTag": {
      "img": ["alt", "width", "height", "sizes", "src", "loading", "decoding"],
      "input": ["type", "placeholder", "autocomplete", "spellcheck", "enterkeyhint"],
      "button": ["type", "disabled"],
      "select": ["disabled"],
      "option": ["value", "selected", "disabled", "label"],
      "time": ["datetime"],
      "label": ["for"],
      "details": ["name"],
      "use": ["href", "xlink:href"]
    },
    "svg": [
      "viewbox", "xmlns", "fill", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin", "stroke-dasharray",
      "stroke-dashoffset", "stroke-opacity", "fill-opacity", "fill-rule", "clip-rule", "clip-path", "mask", "opacity",
      "d", "cx", "cy", "r", "rx", "ry", "x", "y", "x1", "x2", "y1", "y2", "dx", "dy", "points", "width", "height",
      "transform", "offset", "stop-color", "stop-opacity", "gradientunits", "gradienttransform", "preserveaspectratio",
      "font-size", "font-weight", "text-anchor", "dominant-baseline", "pathlength", "vector-effect"
    ]
  },
  "bindings": {
    "data-kn-each": { "value": "list", "help": "Repeat this element once per entry of a list. Inside, bare paths read the entry." },
    "data-kn-empty": { "value": "list", "help": "Show this element only when the list is empty." },
    "data-kn-if": { "value": "condition", "help": "Render only when true: `path`, `!path`, `path=value` or `path!=value`." },
    "data-kn-switch": { "value": "path", "help": "Render the first child whose data-kn-case matches the value, else the data-kn-default child." },
    "data-kn-case": { "value": "literal", "help": "A value for the parent data-kn-switch." },
    "data-kn-default": { "value": "none", "help": "The child of a data-kn-switch used when no case matches." },
    "data-kn-use": { "value": "partial", "help": "Fill this element with partials/<name>.html, using the current scope." },
    "data-kn-slot": { "value": "enum", "values": ["outlet", "extras"], "help": "outlet: where the page goes (shell). extras: where Kinora adds future panels (pages)." },
    "data-kn-text": { "value": "path", "help": "Set the text. Empty values add data-empty so CSS can hide the element." },
    "data-kn-attr": { "value": "attrmap", "help": "Set attributes from paths: `title:overview aria-label:title`." },
    "data-kn-img": { "value": "images", "help": "On <img>: the first available image of these kinds (poster backdrop thumb logo avatar)." },
    "data-kn-bg": { "value": "images", "help": "Set --kn-bg: url(...) for a CSS background, from the first available image kind." },
    "data-kn-size": { "value": "literal", "help": "Width in px to request for data-kn-img / data-kn-bg (160, 240, 320, 480, 640, 780, 1280 or 1920)." },
    "data-kn-progress": { "value": "path", "help": "Set --kn-progress (0 to 1) and the width of a data-kn-fill child." },
    "data-kn-fill": { "value": "none", "help": "The filled part of a data-kn-progress bar." },
    "data-kn-link": { "value": "enum", "values": ["item", "play", "resume", "library", "home", "search", "settings", "admin", "parent", "series", "season", "back"], "help": "Make this a link. item/play/resume/parent/series use the current item, library the current library, season the current season tab." },
    "data-kn-action": { "value": "enum", "values": ["play", "resume", "restart", "toggle-played", "logout", "next-season", "prev-season"], "help": "Make this a button that does something." },
    "data-kn-search": { "value": "none", "help": "On <input type=\"search\">: live search; Enter opens the search page." },
    "data-kn-select": { "value": "enum", "values": ["sort", "season"], "help": "On <select>: filled with the options and wired up." },
    "data-kn-rail": { "value": "none", "help": "A horizontal scroller with snap points and remembered position." },
    "data-kn-scroll": { "value": "enum", "values": ["prev", "next"], "help": "Inside a data-kn-rail: page it back or forward. Disabled at the ends." },
    "data-kn-carousel": { "value": "duration", "help": "Rotate the children, e.g. `8s`. Pauses on hover, focus and reduced motion. Sets data-current on the visible child." },
    "data-kn-carousel-dots": { "value": "none", "help": "Filled with one button per carousel slide." },
    "data-kn-component": { "value": "enum", "values": ["user-menu", "search-box", "watch-party"], "help": "Kinora renders its own widget here, styled with theme tokens." },
    "data-kn-part": { "value": "literal", "help": "Names a part of a component for styling." },
    "data-kn-focus-group": { "value": "literal", "help": "Left/right stay inside this group; up/down return to the last focused item." },
    "data-kn-focus-default": { "value": "none", "help": "Where focus starts on this page." },
    "data-kn-focus-scroll": { "value": "enum", "values": ["center", "nearest"], "help": "How a focused element scrolls into view." },
    "data-kn-layout": { "value": "enum", "values": ["stack", "row", "grid", "rail", "hero", "split", "overlay", "center"], "help": "Opt-in building blocks from Kinora's layout layer, tuned with --kn-gap, --kn-card-w, --kn-cols and --kn-split. Your own CSS always wins." },
    "data-kn-virtual": { "value": "none", "help": "On a data-kn-each list: render in chunks as you scroll (large libraries)." }
  },
  "renamed": {
    "bindings": {},
    "fields": {}
  },
  "imageKinds": ["poster", "backdrop", "thumb", "logo", "avatar"],
  "imageWidths": [160, 240, 320, 480, 640, 780, 1280, 1920],
  "loopHelpers": ["@index", "@number", "@first", "@last", "@count"],
  "types": {
    "App": {
      "server": "Server",
      "user": "User",
      "libraries": "LibraryLink[]",
      "route": "Route",
      "search": "SearchState",
      "options": "any",
      "device": "text",
      "input": "text"
    },
    "Server": { "name": "text", "version": "text" },
    "User": { "id": "text", "name": "text", "initial": "text", "isAdmin": "bool", "hasAvatar": "bool" },
    "Route": { "name": "text", "path": "text" },
    "SearchState": { "query": "text" },
    "LibraryLink": { "id": "text", "name": "text", "kind": "text", "itemCount": "number", "active": "bool" },
    "Card": {
      "id": "text",
      "kind": "text",
      "title": "text",
      "subtitle": "text",
      "seriesTitle": "text",
      "episodeTitle": "text",
      "episodeCode": "text",
      "year": "text",
      "rating": "text",
      "officialRating": "text",
      "runtimeLabel": "text",
      "progress": "number",
      "remainingLabel": "text",
      "played": "bool",
      "inProgress": "bool",
      "isNew": "bool",
      "isPlayable": "bool",
      "hasPoster": "bool",
      "hasBackdrop": "bool",
      "hasThumb": "bool",
      "hasLogo": "bool",
      "overview": "text",
      "tagline": "text",
      "genres": "text[]",
      "genresLabel": "text",
      "parentId": "text",
      "seriesId": "text"
    },
    "Row": { "id": "text", "title": "text", "kind": "text", "items": "Card[]" },
    "Home": { "rows": "Row[]", "featured": "Card[]", "isEmpty": "bool" },
    "SortOption": { "value": "text", "label": "text", "active": "bool" },
    "Library": {
      "library": "LibraryLink",
      "items": "Card[]",
      "count": "number",
      "countLabel": "text",
      "isEmpty": "bool",
      "isLoading": "bool",
      "sort": "SortOption[]"
    },
    "File": {
      "name": "text",
      "sizeLabel": "text",
      "container": "text",
      "resolution": "text",
      "videoLabel": "text",
      "videoCodec": "text",
      "audioLabel": "text",
      "subtitleLabel": "text",
      "hdr": "text"
    },
    "SeasonTab": { "id": "text", "label": "text", "number": "number", "active": "bool" },
    "Item": {
      "$extends": "Card",
      "originalTitle": "text",
      "releaseDate": "text",
      "files": "File[]",
      "hasFiles": "bool",
      "children": "Card[]",
      "seasons": "SeasonTab[]",
      "hasSeasons": "bool",
      "season": "SeasonTab",
      "episodes": "Card[]",
      "hasEpisodes": "bool",
      "nextUp": "Card",
      "canPlay": "bool",
      "canResume": "bool",
      "playLabel": "text",
      "resumeLabel": "text",
      "playedLabel": "text"
    },
    "Search": { "query": "text", "hasQuery": "bool", "results": "Card[]", "isEmpty": "bool", "isSearching": "bool", "countLabel": "text" }
  }
}
