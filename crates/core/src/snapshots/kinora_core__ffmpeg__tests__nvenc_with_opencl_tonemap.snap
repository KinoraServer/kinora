---
source: crates/core/src/ffmpeg.rs
expression: "run(&transcode_plan(true), HwAccel::Nvenc, Tonemapper::Opencl, false, 0)"
---
-hide_banner -loglevel error -nostdin -y -init_hw_device opencl=ocl -filter_hw_device ocl -hwaccel cuda -copyts -start_at_zero -avoid_negative_ts disabled -i /media/Movie (2020)/Movie.mkv -map 0:0 -map 0:1 -sn -dn -map_metadata -1 -map_chapters -1 -vf scale=1920:1080,format=p010,hwupload,tonemap_opencl=tonemap=hable:desat=0:t=bt709:m=bt709:p=bt709:r=tv:format=nv12,hwdownload,format=nv12 -c:v h264_nvenc -preset p4 -profile:v high -forced-idr 1 -b:v 10000000 -maxrate 10000000 -bufsize 20000000 -force_key_frames expr:gte(t,0+n_forced*6) -g 144 -c:a aac -ac 2 -b:a 192000 -f hls -hls_time 6 -hls_segment_type mpegts -hls_list_size 0 -hls_flags temp_file -start_number 0 -hls_segment_filename /tmp/t/abc/seg_%d.ts /tmp/t/abc/ffmpeg.m3u8
