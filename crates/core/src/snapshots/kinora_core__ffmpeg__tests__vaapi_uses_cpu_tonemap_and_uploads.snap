---
source: crates/core/src/ffmpeg.rs
expression: "run(&transcode_plan(true), HwAccel::Vaapi\n{ device: \"/dev/dri/renderD128\".into() }, Tonemapper::Libplacebo, false, 0)"
---
-hide_banner -loglevel error -nostdin -y -init_hw_device vaapi=va:/dev/dri/renderD128 -filter_hw_device va -hwaccel vaapi -hwaccel_device /dev/dri/renderD128 -copyts -start_at_zero -avoid_negative_ts disabled -i /media/Movie (2020)/Movie.mkv -map 0:0 -map 0:1 -sn -dn -map_metadata -1 -map_chapters -1 -vf scale=1920:1080,zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=tonemap=hable:desat=0,zscale=t=bt709:m=bt709:r=tv,format=yuv420p,format=nv12,hwupload -c:v h264_vaapi -profile:v high -b:v 10000000 -maxrate 10000000 -bufsize 20000000 -force_key_frames expr:gte(t,0+n_forced*6) -g 144 -c:a aac -ac 2 -b:a 192000 -f hls -hls_time 6 -hls_segment_type mpegts -hls_list_size 0 -hls_flags temp_file -start_number 0 -hls_segment_filename /tmp/t/abc/seg_%d.ts /tmp/t/abc/ffmpeg.m3u8
