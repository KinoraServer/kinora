---
source: crates/core/src/ffmpeg.rs
expression: "run(&transcode_plan(true), HwAccel::Nvenc, Tonemapper::Libplacebo, false, 0)"
---
-hide_banner -loglevel error -nostdin -y -init_hw_device vulkan=vk -filter_hw_device vk -hwaccel cuda -copyts -start_at_zero -avoid_negative_ts disabled -i /media/Movie (2020)/Movie.mkv -map 0:0 -map 0:1 -sn -dn -map_metadata -1 -map_chapters -1 -vf hwupload,libplacebo=w=1920:h=1080:tonemapping=bt.2390:colorspace=bt709:color_primaries=bt709:color_trc=bt709:range=tv:format=yuv420p,hwdownload,format=yuv420p -c:v h264_nvenc -preset p4 -profile:v high -forced-idr 1 -b:v 10000000 -maxrate 10000000 -bufsize 20000000 -force_key_frames expr:gte(t,0+n_forced*6) -g 144 -c:a aac -ac 2 -b:a 192000 -f hls -hls_time 6 -hls_segment_type mpegts -hls_list_size 0 -hls_flags temp_file -start_number 0 -hls_segment_filename /tmp/t/abc/seg_%d.ts /tmp/t/abc/ffmpeg.m3u8
