---
source: crates/core/src/ffmpeg.rs
expression: "run(&remux_plan(), HwAccel::Nvenc, Tonemapper::Libplacebo, false, 0)"
---
-hide_banner -loglevel error -nostdin -y -copyts -start_at_zero -avoid_negative_ts disabled -i /media/Movie (2020)/Movie.mkv -map 0:0 -map 0:1 -sn -dn -map_metadata -1 -map_chapters -1 -c:v copy -c:a copy -f hls -hls_time 6 -hls_segment_type mpegts -hls_list_size 0 -hls_flags temp_file -start_number 0 -hls_segment_filename /tmp/t/abc/seg_%d.ts /tmp/t/abc/ffmpeg.m3u8
