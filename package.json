{
  "name": "kinora-dev",
  "private": true,
  "description": "Dev tooling for the Kinora repo (git hooks and formatting). The app itself is in crates/ and web/.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "web/**/*.{ts,tsx,css,json}": "prettier --write",
    "*.{md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.2"
  }
}
