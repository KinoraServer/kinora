# All optional. Defaults shown.

# Where the database, settings and themes live. In Docker: /config
KINORA_CONFIG_DIR=./data
# Image cache (safe to delete). Default: $KINORA_CONFIG_DIR/cache
KINORA_CACHE_DIR=
# Temporary transcode segments; fast disk or RAM disk recommended. Default: $KINORA_CACHE_DIR/transcodes
KINORA_TRANSCODE_DIR=
KINORA_BIND=0.0.0.0
KINORA_PORT=8420
# Paths to ffmpeg / ffprobe if they aren't on PATH
KINORA_FFMPEG=ffmpeg
KINORA_FFPROBE=ffprobe
# Seeds the TMDB module's API key (install the module in Admin → Modules & themes, or set the key there)
TMDB_API_KEY=
# Log level, e.g. info, debug, kinora=debug
KINORA_LOG=info
# Files read at once during library scans (and TMDB lookups). Default 8; lower for slow spinning disks, higher for SSDs/NVMe
KINORA_SCAN_CONCURRENCY=8
# Where Admin → Modules & themes installs packages from: the folder holding index.json. Default: the official registry
KINORA_REGISTRY_URL=
# Base64 Ed25519 public key(s), comma separated, your own registry signs its index with
KINORA_REGISTRY_KEY=
